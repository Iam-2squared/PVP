[Unit]
Description=PVP Selesia Godot authoritative PvP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pvp
Group=pvp
WorkingDirectory=/opt/pvp/repo
Environment=HOME=/var/lib/pvp
Environment=XDG_DATA_HOME=/var/lib/pvp
Environment=XDG_CACHE_HOME=/var/cache/pvp
ExecStart=/usr/local/bin/godot-pvp --headless --path /opt/pvp/repo --script res://tools/run_battle_server.gd -- --bind=127.0.0.1 --port=8910 --save-dir=/var/lib/pvp/profiles
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=pvp
StateDirectoryMode=0700
CacheDirectory=pvp
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
LimitNOFILE=4096
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
